+bool CGraphics_Threaded::UpdateTextureRgba(CTextureHandle TextureId, int x, int y, size_t Width, size_t Height, const uint8_t *pData)
+{
+	if(!TextureId.IsValid() || pData == nullptr || Width == 0 || Height == 0)
+		return false;
+
+	// The command buffer's data ring holds CMD_BUFFER_DATA_BUFFER_SIZE bytes
+	// (2 MB). A payload larger than that cannot be handed over in one piece and
+	// drops off the fast path, so upload it in horizontal bands that each fit.
+	// This is what made large video backgrounds unusable: a 854x480 RGBA frame is
+	// 1.6 MB (fits, menu ran at ~203 fps) while 1280x720 is 3.7 MB and 2K is
+	// 9.4 MB (did not fit, menu fell to ~16 fps and ~4 fps respectively) — the
+	// cost tracked the texture size, not the decode cost.
+	const size_t RowBytes = Width * 4;
+	size_t RowsPerBand = (size_t)CMD_BUFFER_DATA_BUFFER_SIZE / RowBytes;
+	if(RowsPerBand == 0)
+		RowsPerBand = 1;
+
+	for(size_t Row = 0; Row < Height; Row += RowsPerBand)
+	{
+		const size_t BandRows = std::min(RowsPerBand, Height - Row);
+		const size_t MemSize = BandRows * RowBytes;
+
+		CCommandBuffer::SCommand_Texture_Update Cmd;
+		Cmd.m_Slot = TextureId.Id();
+		Cmd.m_X = x;
+		Cmd.m_Y = y + (int)Row;
+		Cmd.m_Width = Width;
+		Cmd.m_Height = BandRows;
+
+		// The command buffer owns the pixels until the backend has uploaded them.
+		uint8_t *pTmpData = static_cast<uint8_t *>(malloc(MemSize));
+		if(pTmpData == nullptr)
+			return false;
+		mem_copy(pTmpData, pData + Row * RowBytes, MemSize);
+		Cmd.m_pData = pTmpData;
+		AddCmd(Cmd);
+	}
+
+	return true;
+}
+
